# ==============================================================================
# ALPHANEXUS – Environment Configuration Template
# Copy this file to .env and configure with your environment values.
# ==============================================================================

# Application Identity & Mode
APP_NAME=ALPHANEXUS
APP_ENV=development
APP_DEBUG=true
DATA_MODE=demo

# Server Hosts & Networking
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8501
FRONTEND_URL=http://localhost:8501

# Database Configuration (Supabase PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Supabase Auth, Storage & Realtime
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=alphanexus-documents

# MongoDB Atlas Vector Search Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/
MONGODB_DATABASE=alphanexus_rag

# AI & LLM Reasoning Providers
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_MODEL=

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu

# Indian Market Data Provider (DhanHQ - NSE/BSE)
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_jwt_token

# Financial News Provider (Marketaux)
MARKETAUX_API_TOKEN=your_marketaux_api_token

# Global Fundamentals Provider (Financial Modeling Prep)
FMP_API_KEY=your_fmp_api_key

# Observability, Tracing & LLM-Ops (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Security & Session Authentication
SECRET_KEY=your_super_secret_jwt_random_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

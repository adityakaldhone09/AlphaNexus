# ==============================================================================
# ALPHANEXUS – Environment Configuration Template
# Copy this file to .env and configure with your environment values.
# ==============================================================================

# Application Identity & Mode
APP_NAME=AlphaNexus
APP_ENV=development
APP_DEBUG=true
DATA_MODE=live

# Server Hosts & Networking
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# Database Configuration (Supabase PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Supabase Auth, Storage & Realtime
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_STORAGE_BUCKET=alphanexus-documents

# MongoDB Atlas Vector Search Database (Optional)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/
MONGODB_DB=alphanexus_rag

# AI & LLM Reasoning Providers
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

# Indian Market Intelligence API (IndianAPI - stock.indianapi.in)
INDIANAPI_API_KEY=your_indianapi_key
INDIANAPI_BASE_URL=https://stock.indianapi.in
INDIANAPI_TIMEOUT=15

# Indian Market Data Provider (DhanHQ - NSE/BSE)
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_jwt_token

# Financial News Providers (Marketaux & NewsAPI)
MARKETAUX_API_TOKEN=your_marketaux_api_token
NEWSAPI_API_KEY=your_newsapi_key

# Global Fundamentals & Market Data (FMP & Finnhub)
FMP_API_KEY=your_fmp_api_key
FINHUB_API_KEY=your_finnhub_api_key
FINNHUB_API_KEY=your_finnhub_api_key

# Observability, Tracing & Error Monitoring (Langfuse & Sentry)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
SENTRY_DSN=

# Security & Session Authentication
SECRET_KEY=your_super_secret_jwt_random_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# EquiLens AI - Environment Configuration Example
# Copy to .env in your root or backend directory as needed

# Application Settings
APP_ENV=development
APP_NAME=AlphaNexus
APP_DEBUG=true
DATA_MODE=demo

# Server URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Database Configuration (PostgreSQL + pgvector or Supabase connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alphanexus
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/alphanexus

# Supabase (Managed Auth, Storage, and Database)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=alphanexus-documents

# AI & LLM Providers
GEMINI_API_KEY=
# Configured model is checked against the account's generateContent model catalog.
GEMINI_MODEL=gemini-1.5-flash
# Optional. If unset, an accessible model is selected from the live catalog when needed.
GEMINI_FALLBACK_MODEL=

GROQ_API_KEY=
# Configured model is checked against the account's model catalog.
GROQ_MODEL=llama-3.3-70b-versatile
# Optional. If unset, an accessible chat model is selected from the live catalog when needed.
GROQ_FALLBACK_MODEL=

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

# Market Data Providers (Indian Equities - NSE/BSE)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Financial News Provider
MARKETAUX_API_TOKEN=

# Fundamental Data Provider (Optional)
FMP_API_KEY=

# Observability and Monitoring
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=

# Security
SECRET_KEY=equilens_ai_super_secret_jwt_key_development_only_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

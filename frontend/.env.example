# AlphaNexus – Frontend Environment Variables
# Copy to .env.local and fill in your values.
# Only VITE_* variables are included in the browser bundle.
# Never put backend secrets or service-role keys here.

# Backend API base URL (proxied via Vite in dev, direct in production)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase – publishable keys only (safe for the browser)
# Get these from: https://supabase.com/dashboard/project/ceedxgiuppobapaypxnb/settings/api
VITE_SUPABASE_URL=https://ceedxgiuppobapaypxnb.supabase.co
VITE_SUPABASE_ANON_KEY=

# App metadata
VITE_APP_NAME=AlphaNexus
VITE_APP_ENV=development
